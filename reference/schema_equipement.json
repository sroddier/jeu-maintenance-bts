{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/jeu-maintenance/schema_equipement.json",
  "title": "Usine fictive et équipements — jeu sérieux BTS MS",
  "description": "Durées en heures d'ouverture (_h), coûts en euros HT (_eur), cadences en bouteilles par heure.",
  "type": "object",
  "required": [
    "meta",
    "organisation",
    "couts",
    "pieces",
    "equipements"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "nom",
        "version"
      ],
      "properties": {
        "nom": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "avertissement": {
          "type": "string"
        },
        "unites": {
          "type": "string"
        }
      }
    },
    "organisation": {
      "type": "object",
      "required": [
        "heures_ouverture_par_semaine"
      ],
      "properties": {
        "postes_par_jour": {
          "type": "integer",
          "minimum": 1
        },
        "heures_par_poste": {
          "type": "number",
          "minimum": 0
        },
        "jours_par_semaine": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "heures_ouverture_par_semaine": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "horaires": {
          "type": "string"
        },
        "produit": {
          "type": "string"
        },
        "marge_sur_cout_variable_eur_par_bouteille": {
          "type": "number",
          "minimum": 0
        },
        "cout_rebut_eur_par_bouteille": {
          "type": "number",
          "minimum": 0
        },
        "coefficient_propagation_arret_hors_goulot": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hors_specialite": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "majoration_reparation_active_pct",
            "s_applique_a",
            "arrondi",
            "minimum_h",
            "s_applique_au_depannage_provisoire",
            "concerne_sous_traitance",
            "entre_dans_mttr",
            "niveaux"
          ],
          "description": "Technicien hors de sa spécialité : réparation active majorée (pas la détection, ni l'attente, ni la remise en service)",
          "properties": {
            "majoration_reparation_active_pct": {
              "type": "number",
              "minimum": 0
            },
            "s_applique_a": {
              "const": "reparation_active"
            },
            "arrondi": {
              "const": "quart_heure_le_plus_proche"
            },
            "minimum_h": {
              "type": "number",
              "minimum": 0
            },
            "s_applique_au_depannage_provisoire": {
              "type": "boolean"
            },
            "concerne_sous_traitance": {
              "type": "boolean"
            },
            "entre_dans_mttr": {
              "type": "boolean"
            },
            "niveaux": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              }
            }
          }
        }
      }
    },
    "couts": {
      "type": "object",
      "required": [
        "taux_main_oeuvre_eur_par_h",
        "penalite_arret_goulot_eur_par_h",
        "penalite_arret_autre_eur_par_h"
      ],
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "politique_initiale": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id_mode",
          "type_maintenance"
        ],
        "properties": {
          "id_mode": {
            "type": "string"
          },
          "type_maintenance": {
            "enum": [
              "corrective_immediate",
              "corrective_differee",
              "preventive_systematique",
              "preventive_conditionnelle",
              "preventive_previsionnelle",
              "amelioration"
            ]
          },
          "action": {
            "type": "string"
          },
          "periode_semaines": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "hors_temps_ouverture": {
            "type": "boolean"
          },
          "duree_h": {
            "type": "number",
            "minimum": 0
          },
          "nb_techniciens": {
            "type": "integer",
            "minimum": 1
          },
          "cout_eur": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "evenements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "liste"
      ],
      "properties": {
        "niveau_1": {
          "type": "string"
        },
        "liste": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id_evenement",
              "designation",
              "niveaux",
              "probabilite",
              "base_probabilite",
              "max_par_partie",
              "effet_numerique",
              "parametres"
            ],
            "properties": {
              "id_evenement": {
                "type": "string",
                "pattern": "^E[0-9]{2}$"
              },
              "designation": {
                "type": "string"
              },
              "niveaux": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6
                }
              },
              "probabilite": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "probabilité par unité de base_probabilite"
              },
              "base_probabilite": {
                "enum": [
                  "tour",
                  "commande_standard",
                  "livraison",
                  "partie"
                ]
              },
              "max_par_partie": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "effet_numerique": {
                "type": "boolean"
              },
              "parametres": {
                "type": "object"
              }
            },
            "if": {
              "properties": {
                "effet_numerique": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "niveaux": {
                  "items": {
                    "minimum": 2
                  }
                }
              }
            }
          }
        }
      }
    },
    "pieces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/piece"
      }
    },
    "equipements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/equipement"
      }
    }
  },
  "$defs": {
    "piece": {
      "type": "object",
      "required": [
        "ref",
        "designation",
        "prix_unitaire_eur"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^P-[A-Z]{3}-[0-9]{2}$"
        },
        "designation": {
          "type": "string"
        },
        "prix_unitaire_eur": {
          "type": "number",
          "minimum": 0
        },
        "delai_standard_semaines": {
          "type": "number",
          "minimum": 0
        },
        "stock_initial": {
          "type": "integer",
          "minimum": 0
        },
        "stock_mini": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "mode": {
      "type": "object",
      "required": [
        "id_mode",
        "id_sous_ensemble",
        "designation",
        "specialite",
        "loi",
        "beta",
        "eta_h",
        "gamma_h",
        "effet_correctif",
        "mttr_actif_h",
        "depannage_provisoire"
      ],
      "additionalProperties": false,
      "properties": {
        "id_mode": {
          "type": "string",
          "pattern": "^[A-Z]{3}-M[0-9]+$"
        },
        "id_sous_ensemble": {
          "type": "string"
        },
        "designation": {
          "type": "string"
        },
        "loi": {
          "enum": [
            "exponentielle",
            "weibull"
          ]
        },
        "beta": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Paramètre de forme (sans unité)"
        },
        "eta_h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Paramètre d'échelle, en heures de fonctionnement"
        },
        "gamma_h": {
          "type": "number",
          "minimum": 0,
          "description": "Paramètre de position, en heures"
        },
        "lambda_par_h": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "description": "Taux de défaillance constant (1/h) si loi exponentielle"
        },
        "mtbf_theorique_h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "gamma + eta·Γ(1+1/β), en heures"
        },
        "effet_correctif": {
          "enum": [
            "renouvellement",
            "reparation_minimale"
          ],
          "description": "renouvellement : âge remis à 0 ; réparation minimale : âge inchangé"
        },
        "mttr_actif_h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Moyenne des durées de réparation active (h)"
        },
        "sigma_log_reparation": {
          "type": "number",
          "minimum": 0,
          "description": "Écart-type du logarithme des durées de réparation (loi log-normale)"
        },
        "pieces_corrective": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Pièces consommables en correctif pour ce mode"
        },
        "pieces_preventive": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Pièces consommables en préventif pour ce mode"
        },
        "mode_detection": {
          "type": "string"
        },
        "probabilite_piece_en_stock": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "specialite": {
          "enum": [
            "electrique",
            "mecanique"
          ],
          "description": "Spécialité du technicien qui intervient sans majoration"
        },
        "depannage_provisoire": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "autorise",
            "ratio_reparation_active",
            "duree_reparation_active_h",
            "duree_reparation_active_hors_specialite_h",
            "pieces",
            "reapparition_apres_h",
            "annule_par_curatif_differe"
          ],
          "description": "Règle du dépannage provisoire (action palliative). Détection et remise en service inchangées.",
          "properties": {
            "autorise": {
              "type": "boolean",
              "description": "false si un palliatif n'a pas de sens métier pour ce mode"
            },
            "ratio_reparation_active": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1,
              "description": "Part de mttr_actif_h (0,4)"
            },
            "duree_reparation_active_h": {
              "type": "number",
              "minimum": 0.25,
              "multipleOf": 0.25,
              "description": "Valeur figée = ratio × mttr_actif_h, arrondie au ¼ h le plus proche, minimum 0,25 h"
            },
            "pieces": {
              "type": "array",
              "maxItems": 0,
              "description": "Aucune pièce consommée"
            },
            "reapparition_apres_h": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "La panne revient après ce temps d'ouverture (le mode n'est pas remis à neuf)"
            },
            "annule_par_curatif_differe": {
              "type": "boolean",
              "description": "true : une réparation curative différée faite le samedi (hors ouverture) annule la réapparition"
            },
            "justification": {
              "type": [
                "string",
                "null"
              ],
              "description": "Motif métier quand autorise = false"
            },
            "duree_reparation_active_hors_specialite_h": {
              "type": "number",
              "minimum": 0.25,
              "multipleOf": 0.25,
              "description": "Valeur figée = arrondi au ¼ h de 1,25 × duree_reparation_active_h (technicien hors spécialité)"
            }
          },
          "if": {
            "properties": {
              "autorise": {
                "const": false
              }
            }
          },
          "then": {
            "required": [
              "justification"
            ],
            "properties": {
              "justification": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        },
        "periode_optimale": {
          "type": "object",
          "required": [
            "modele",
            "cout_preventif_eur",
            "cout_defaillance_moyen_eur"
          ],
          "additionalProperties": false,
          "description": "Données du préventif systématique : Cp, Cc et modèle de période optimale",
          "properties": {
            "modele": {
              "enum": [
                "remplacement_selon_age",
                "remplacement_periodique_reparation_minimale"
              ]
            },
            "cout_preventif_eur": {
              "type": "number",
              "minimum": 0,
              "description": "Cp : coût d'une intervention préventive"
            },
            "cout_defaillance_moyen_eur": {
              "type": "number",
              "minimum": 0,
              "description": "Cc : coût complet moyen d'une défaillance (direct + indirect)"
            },
            "periode_optimale_h": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "periode_retenue_semaines": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "loi": {
                "const": "exponentielle"
              }
            }
          },
          "then": {
            "properties": {
              "beta": {
                "const": 1
              },
              "gamma_h": {
                "const": 0
              },
              "lambda_par_h": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "equipement": {
      "type": "object",
      "required": [
        "id_equipement",
        "designation",
        "fonction",
        "cadence_nominale_bouteilles_par_h",
        "goulot",
        "penalite_arret_eur_par_h",
        "sous_ensembles",
        "modes"
      ],
      "additionalProperties": false,
      "properties": {
        "id_equipement": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "designation": {
          "type": "string"
        },
        "fonction": {
          "type": "string"
        },
        "cadence_nominale_bouteilles_par_h": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "goulot": {
          "type": "boolean"
        },
        "penalite_arret_eur_par_h": {
          "type": "number",
          "minimum": 0
        },
        "sous_ensembles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id_sous_ensemble",
              "designation"
            ],
            "properties": {
              "id_sous_ensemble": {
                "type": "string"
              },
              "designation": {
                "type": "string"
              }
            }
          }
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mode"
          }
        },
        "mtbf_theorique_equipement_h": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}